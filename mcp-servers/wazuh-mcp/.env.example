# Wazuh indexer (OpenSearch) connection — used for alert search/lookup
WAZUH_INDEXER_URL=https://wazuh-vm.local:9200
WAZUH_INDEXER_USER=admin
WAZUH_INDEXER_PASSWORD=changeme
# Set to "true" only for self-signed certs in the homelab; keep verification on elsewhere
WAZUH_INDEXER_VERIFY_SSL=false

# Alert index pattern to search against
WAZUH_ALERTS_INDEX=wazuh-alerts-*

# MCP server bind address (streamable-http transport)
MCP_HOST=0.0.0.0
MCP_PORT=8000
