proxmox_endpoint = "https://192.168.1.12:8006/"
proxmox_node     = "pve"

# The API token is not set here: put TF_VAR_proxmox_api_token in infra/.env (see .env.example).

template_vm_id = 9000 # VM ID of your cloud-init-enabled template

vm_username    = "ops"
ssh_public_key = "ssh-ed25519 AAAA... you@yourhost"

network_bridge = "vmbr0"
